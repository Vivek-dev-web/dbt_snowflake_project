	measure 'Total Revenue' = SUM(fact_orders[revenue])
		formatString: $#,##0
		lineageTag: c66ef39c-a133-43d9-a5fd-774ec0a5367e

	measure 'Total Orders' = DISTINCTCOUNT(fact_orders[order_id])
		formatString: #,##0
		lineageTag: ce73b291-4af1-4fab-8ddc-bf251911fe6a

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: $#,##0.00
		lineageTag: 4182480f-9b62-4e54-adca-8767e98a0b2d

